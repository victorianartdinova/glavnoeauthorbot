{
  "post_length": {
    "min_words": 100,
    "target_words": 140,
    "max_words": 220
  },
  "banned_phrases": [
    "поверьте",
    "честно говоря",
    "если честно"
  ],
  "banned_openers": [
    "Друзья!",
    "Дорогие друзья",
    "Привет всем"
  ],
  "phrase_variation": true,
  "hook_templates": [
    "💎 {price} млн за квартиру в {location}",
