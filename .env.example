# === GLAVNOE BOT Configuration ===
# Не смешивайте env от разных ботов!

# Telegram Bot Token (от @BotFather)
TELEGRAM_BOT_TOKEN=your_glavnoe_bot_token_here

# Claude API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Team Chat ID (куда отправлять уведомления)
TEAM_CHAT_ID=-1002367799345

# Bot Identity (для валидации)
EXPECTED_BOT_USERNAME=glavnoeauthor_bot
EXPECTED_PRODUCT_NAME=GLAVNOE Bot

# Optional: Admin user ID (для /dev команды)
# ADMIN_USER_ID=123456789

# Optional: Feature Flags (по умолчанию выключены)
# ENABLE_LOT_CARD=0
# ENABLE_PACKAGE_BY_LOT=0
# ENABLE_BRIEF_SHORT=0
# ENABLE_PLAN_EXPORT=0
